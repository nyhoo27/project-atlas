# Supabase project settings
# Find these in your Supabase project: Settings -> API

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Public anon key (safe to expose to the browser, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service role key (SERVER-SIDE ONLY, never expose to the browser)
# Used only in trusted server code, e.g. the signup flow and the dev seed script.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Invite code required to create a new workspace (SERVER-SIDE ONLY).
# Share it only with people you want to have their own workspace.
# If this is left empty, signup is CLOSED — nobody can create a workspace.
# Existing users can always still log in.
SIGNUP_INVITE_CODE=pick-a-secret-code
